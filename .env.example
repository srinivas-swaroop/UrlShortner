# Copy this file to .env and replace the example passwords.
DB_NAME=urlshort
DB_USER=tinymx
DB_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password
APP_BASE_URL=http://localhost:8080
PORT=8080

# Optional. URL shortening works without Gemini; AI insights need a valid key/model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
